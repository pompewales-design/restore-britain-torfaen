{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "shiny-grass-9540",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/members", "/members/*"]
  },
  "secrets": {
    "required": ["MEMBERS_PASSWORD"]
  }
}
